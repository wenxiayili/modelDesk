{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "模型工作台",
  "version": "0.1.1",
  "identifier": "com.modeldesk.viewer",
  "build": {
    "beforeDevCommand": "node scripts/serve-static.js",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "node scripts/prepare-tauri-dist.js",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "模型工作台",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "maximized": false,
        "decorations": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "模型工作台",
    "category": "DeveloperTool",
    "icon": ["icons/icon.ico"],
    "windows": {
      "wix": {
        "language": "zh-CN"
      }
    },
    "fileAssociations": [
      {
        "ext": ["glb"],
        "name": "glTF 二进制模型",
        "description": "glTF 二进制三维模型",
        "mimeType": "model/gltf-binary",
        "role": "Viewer"
      },
      {
        "ext": ["gltf"],
        "name": "glTF 模型",
        "description": "glTF 三维模型",
        "mimeType": "model/gltf+json",
        "role": "Viewer"
      },
      {
        "ext": ["obj"],
        "name": "OBJ 模型",
        "description": "OBJ 三维模型",
        "mimeType": "model/obj",
        "role": "Viewer"
      },
      {
        "ext": ["stl"],
        "name": "STL 模型",
        "description": "STL 三维模型",
        "mimeType": "model/stl",
        "role": "Viewer"
      },
      {
        "ext": ["fbx"],
        "name": "FBX 模型",
        "description": "FBX 三维模型",
        "mimeType": "application/octet-stream",
        "role": "Viewer"
      },
      {
        "ext": ["babylon"],
        "name": "Babylon 场景",
        "description": "Babylon.js 场景",
        "mimeType": "application/json",
        "role": "Viewer"
      }
    ],
    "shortDescription": "轻量三维模型查看器",
    "longDescription": "面向 Windows 的轻量三维模型查看器。"
  }
}
